{
  "schema_version": 1,
  "annunciators": [
    {"id":"ann.rps.reactor_trip_state","text":"REACTOR TRIP STATE","panels":["rps","rmcp"],"priority":"critical","condition_expression":"rps.scram_active == true","on_delay_s":0,"off_delay_s":0,"latching":true,"reset_requirement":"operator reset after trip cause clears","audible":"continuous"},
    {"id":"ann.rps.half_reactor_trip","text":"HALF REACTOR TRIP","panels":["rps","rmcp"],"priority":"critical","condition_expression":"rps.channel_a_tripped != rps.channel_b_tripped","on_delay_s":0,"off_delay_s":0,"latching":false,"reset_requirement":"none","audible":"continuous"},
    {"id":"ann.rmcp.low_reactor_water_level","text":"LOW REACTOR WATER LEVEL","panels":["mcc","eccs","rmcp"],"priority":"warning","condition_expression":"reactor.level_nr_m < (mcc.sp_reactor_level_m - 0.3)","on_delay_s":1,"off_delay_s":2,"latching":false,"reset_requirement":"none","audible":"repeating"},
    {"id":"ann.rmcp.high_reactor_water_level","text":"HIGH REACTOR WATER LEVEL","panels":["mcc","rmcp"],"priority":"warning","condition_expression":"reactor.level_nr_m > (mcc.sp_reactor_level_m + 0.3)","on_delay_s":1,"off_delay_s":2,"latching":false,"reset_requirement":"none","audible":"repeating"},
    {"id":"ann.rmcp.high_rpv_pressure","text":"HIGH RPV PRESSURE","panels":["srv","rmcp"],"priority":"warning","condition_expression":"reactor.pressure_kpa > 7600","on_delay_s":0,"off_delay_s":2,"latching":false,"reset_requirement":"none","audible":"repeating"},
    {"id":"ann.rps.reactor_pressure_high_trip","text":"RPS REACTOR PRESSURE HIGH TRIP","panels":["rps"],"priority":"critical","condition_expression":"reactor.pressure_kpa >= 7900","on_delay_s":0,"off_delay_s":0,"latching":true,"reset_requirement":"trip reset sequence","audible":"continuous"},
    {"id":"ann.cond.no_condenser_vacuum","text":"NO CONDENSER VACUUM","panels":["cond","turb"],"priority":"critical","condition_expression":"cond.pressure_mbar > 150","on_delay_s":1,"off_delay_s":2,"latching":false,"reset_requirement":"none","audible":"continuous"},
    {"id":"ann.cond.low_condenser_vacuum","text":"LOW CONDENSER VACUUM","panels":["cond"],"priority":"warning","condition_expression":"cond.pressure_mbar > 80","on_delay_s":2,"off_delay_s":3,"latching":false,"reset_requirement":"none","audible":"repeating"},
    {"id":"ann.elec.bus_a_unpowered","text":"BUS A UNPOWERED","panels":["elec"],"priority":"warning","condition_expression":"elec.bus.a.state != 'ENERGIZED'","on_delay_s":0,"off_delay_s":1,"latching":false,"reset_requirement":"none","audible":"repeating"},
    {"id":"ann.elec.bus_b_unpowered","text":"BUS B UNPOWERED","panels":["elec"],"priority":"warning","condition_expression":"elec.bus.b.state != 'ENERGIZED'","on_delay_s":0,"off_delay_s":1,"latching":false,"reset_requirement":"none","audible":"repeating"},
    {"id":"ann.elec.bus_s_unpowered","text":"BUS S UNPOWERED","panels":["elec"],"priority":"critical","condition_expression":"elec.bus.s.state != 'ENERGIZED'","on_delay_s":0,"off_delay_s":1,"latching":false,"reset_requirement":"none","audible":"continuous"},
    {"id":"ann.elec.dc_bus_unpowered","text":"DC BUS UNPOWERED","panels":["elec"],"priority":"warning","condition_expression":"elec.bus.dc.state != 'ENERGIZED'","on_delay_s":0,"off_delay_s":1,"latching":false,"reset_requirement":"none","audible":"repeating"},
    {"id":"ann.elec.offsite_power_connection_loss","text":"OFFSITE POWER CONNECTION LOSS","panels":["elec","rps"],"priority":"critical","condition_expression":"elec.offsite_power_available == false","on_delay_s":2,"off_delay_s":1,"latching":false,"reset_requirement":"none","audible":"continuous"},
    {"id":"ann.elec.main_battery_critically_low","text":"MAIN BATTERY CRITICALLY LOW","panels":["elec"],"priority":"critical","condition_expression":"elec.battery_pct <= 35","on_delay_s":0,"off_delay_s":2,"latching":false,"reset_requirement":"none","audible":"continuous"},
