    {"id":"ann.eccs.rcic_turbine_running","text":"RCIC TURBINE RUNNING","panels":["eccs","rmcp"],"priority":"info","condition_expression":"eccs.rcic_turbine_rpm > 0","on_delay_s":0,"off_delay_s":1,"latching":false,"reset_requirement":"none","audible":"none"},
