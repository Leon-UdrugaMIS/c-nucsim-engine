    {"id":"ann.turb.turbine_trip","text":"TURBINE TRIP","panels":["turb"],"priority":"critical","condition_expression":"turb.state == 'TRIPPED'","on_delay_s":0,"off_delay_s":0,"latching":true,"reset_requirement":"turbine reset sequence","audible":"continuous"},
    {"id":"ann.turb.generator_reverse_power","text":"GENERATOR REVERSE POWER","panels":["turb"],"priority":"warning","condition_expression":"elec.generator_load_mw < -18.22","on_delay_s":10,"off_delay_s":2,"latching":false,"reset_requirement":"none","audible":"repeating"},
    {"id":"ann.mcc.feedwater_pump_trip","text":"FEEDWATER PUMP TRIP","panels":["mcc","rmcp"],"priority":"critical","condition_expression":"fw.pump_trip == true","on_delay_s":0,"off_delay_s":0,"latching":false,"reset_requirement":"none","audible":"continuous"},
    {"id":"ann.dea.low_low_deaerator_level","text":"LOW LOW DEAERATOR WATER LEVEL","panels":["dea"],"priority":"critical","condition_expression":"dea.level_pct <= 25","on_delay_s":1,"off_delay_s":2,"latching":false,"reset_requirement":"none","audible":"continuous"},
    {"id":"ann.ads.system_armed","text":"ADS SYSTEM ARMED","panels":["ads"],"priority":"info","condition_expression":"ads.armed == true","on_delay_s":0,"off_delay_s":0,"latching":false,"reset_requirement":"none","audible":"none"}
